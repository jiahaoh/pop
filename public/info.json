      "identifier": "apiKeys",
      "textConfig": {
        "height": 56,
        "placeholderText": "填写 API Key",
        "type": "secure"
      },
      "title": "API Key",
      "type": "text"
    },
    {
      "defaultValue": "gpt-5.6-luna",
      "identifier": "model",
      "menuValues": [
        {
          "title": "自定义模型",
          "value": "custom"
        },
        {
          "title": "gemini-3.5-flash-lite",
          "value": "gemini-3.5-flash-lite"
        },
        {
          "title": "gemini-3.6-flash",
          "value": "gemini-3.6-flash"
        },
        {
          "title": "gpt-5.4-mini",
          "value": "gpt-5.4-mini"
        },
        {
          "title": "gpt-5.6-luna",
          "value": "gpt-5.6-luna"
        },
        {
          "title": "MiniMax-M2.7-highspeed",
          "value": "MiniMax-M2.7-highspeed"
        },
        {
          "title": "MiniMax-M3",
          "value": "MiniMax-M3"
        }
      ],
      "title": "模型",
      "type": "menu"
    },
    {
      "desc": "选择「自定义模型」时填写原始 model ID",
      "identifier": "customModel",
      "textConfig": {
        "placeholderText": "gpt-5.6-terra",
        "type": "visible"
      },
      "title": "自定义模型",
      "type": "text"
    },
    {
      "desc": "留空时按模型使用对应的官方 API；使用第三方服务时填写完整请求 URL，格式见配置手册",
      "identifier": "apiUrl",
      "textConfig": {
        "height": 56,
        "placeholderText": "https://example.com/v1/chat/completions",
        "type": "visible"
      },
      "title": "API URL",
      "type": "text"
    },
    {
      "defaultValue": "auto",
      "desc": "自动会按当前 action 选择推荐档位；不支持的模型会省略推理参数",
      "identifier": "reasoningMode",
      "menuValues": [
        {
          "title": "自动（按任务）",
          "value": "auto"
        },
        {
          "title": "模型默认",
          "value": "default"
        },
        {
          "title": "快速",
          "value": "fast"
        },
        {
          "title": "标准",
          "value": "standard"
        },
        {
          "title": "深入",
          "value": "deep"
        }
      ],
      "title": "推理",
      "type": "menu"
    },
    {
      "defaultValue": "enable",
      "identifier": "stream",
      "menuValues": [
        {
          "title": "关闭",
          "value": "disable"
        },
        {
          "title": "开启",
          "value": "enable"
        }
      ],
      "title": "流式输出",
      "type": "menu"
    },
    {
      "desc": "补充所有内置 action 共用的术语、语气或格式偏好",
      "identifier": "additionalRequirements",
      "textConfig": {
        "height": 72,
        "placeholderText": "例如：API 名称保留英文；输出使用简体中文",
        "type": "visible"
      },
      "title": "额外要求",
      "type": "text"
    },
    {
      "desc": "可选额外别名，例如 /s；不能与内置命令冲突",
      "identifier": "customActionCommand",
      "textConfig": {
        "placeholderText": "/s",
        "type": "visible"
      },
      "title": "Custom 命令",
      "type": "text"
    },
    {
      "desc": "定义 Custom 的任务和边界，可用 $sourceLang、$targetLang，不能包含 $text",
      "identifier": "customActionInstruction",
      "textConfig": {
        "height": 88,
        "keyWords": ["$sourceLang", "$targetLang"],
        "placeholderText": "Summarize the text for $targetLang readers. Return only the summary.",
        "type": "visible"
      },
      "title": "Custom 指令",
      "type": "text"
    },
    {
      "defaultValue": "$text",
      "desc": "决定如何把正文交给 Custom，必须包含 $text",
      "identifier": "customActionUserTemplate",
      "textConfig": {
        "height": 72,
        "keyWords": ["$text", "$sourceLang", "$targetLang"],
        "placeholderText": "$text",
        "type": "visible"
      },
      "title": "Custom 正文模板",
      "type": "text"
    }
  ],
  "summary": "对选中文本执行翻译、润色、语法检查、问答、措辞和自定义任务",
  "version": "0.1.0"
}
