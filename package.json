{
  "name": "pop-bobplugin",
  "version": "0.1.1",
  "private": true,
  "description": "Selection-first, one-shot AI actions for Bob.",
  "type": "module",
  "license": "CC BY-NC-SA 4.0",
  "main": "dist/main.js",
  "keywords": [
    "ai",
    "bob-plugin",
    "text-actions"
  ],
  "homepage": "https://github.com/jiahaoh/pop",
  "scripts": {
    "benchmark": "bun run build && bun scripts/benchmark.mts",
    "build": "bun scripts/build.mts",
    "check:runtime": "bun scripts/check-runtime.mts",
    "lint": "biome check . && tsc --noEmit",
    "lint:fix": "biome check --write . && tsc --noEmit",
    "package": "bun scripts/package.mts",
    "release": "bun scripts/package.mts release",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@bob-translate/types": "1.1.0",
    "@types/bun": "1.4.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "bun": "1.2.19"
  },
  "dependencies": {
    "eventsource-parser": "4.1.0"
  }
}
